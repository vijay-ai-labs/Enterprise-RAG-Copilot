# ─── Authentication ────────────────────────────────────────────────────────────
# SECURITY: Set API_KEY before exposing this service to any network.
# Without it, all endpoints (ingest, query, delete) are publicly accessible.
# Use any strong random string, e.g.: openssl rand -hex 32
API_KEY=change-me-before-deploying
# ─── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── Retrieval ──────────────────────────────────────────────────────────────────
TOP_K=5
SIMILARITY_THRESHOLD=0.3      # cosine sim threshold used in dense-only mode (range 0–1)
RRF_SCORE_THRESHOLD=0.005     # score threshold used in hybrid RRF mode (range ~0.01–0.02)
FETCH_K=20
USE_MMR=false
MMR_LAMBDA=0.5

# Hybrid search: dense FAISS + sparse BM25 fused with Reciprocal Rank Fusion
USE_HYBRID_SEARCH=true
BM25_WEIGHT=0.3

# Cross-encoder reranking (enabled by default — ~80 MB model downloaded once on first query)
# Gracefully falls back to score-sorted order if download fails (e.g. no internet).
# Set USE_RERANKER=false to skip reranking and reduce cold-start latency.
USE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ─── Groundedness guard ─────────────────────────────────────────────────────────
# Answers below this threshold are overridden to "I don't know"
GROUNDEDNESS_THRESHOLD=0.25

# ─── Embedding ──────────────────────────────────────────────────────────────────
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_BATCH_SIZE=64

# ─── Generation ─────────────────────────────────────────────────────────────────
# auto = try Ollama → fall back to flan-t5-base
# ollama = require Ollama (error if unreachable)
# flan-t5 = always use flan-t5-base (~250 MB download)
# extractive = keyword-overlap sentences, zero model calls
GENERATION_MODE=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=10.0

# ─── Storage ────────────────────────────────────────────────────────────────────
INDEX_DIR=indexes
LOG_DIR=logs
DB_PATH=data/rag.db
SAVE_INDEX_ON_INGEST=true

# ─── Conversation ───────────────────────────────────────────────────────────────
CONVERSATION_TTL_SECONDS=3600
MAX_CONVERSATION_TURNS=10

# ─── Upload ─────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50.0

# ─── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Timeouts ───────────────────────────────────────────────────────────────────
QUERY_TIMEOUT_SECONDS=60.0

# ─── App ────────────────────────────────────────────────────────────────────────
APP_VERSION=2.0.0

# ─── Frontend (Vite) ────────────────────────────────────────────────────────────
# Set VITE_API_BASE_URL in frontend/.env for production/static deployments.
# Leave empty to use the Vite dev proxy (default for local dev).
# VITE_API_BASE_URL=https://your-api-host.example.com
